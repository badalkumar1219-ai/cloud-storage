# ============================================
# CloudBox – Environment Variables
# ============================================
# Copy this file to backend/.env and fill in
# your real values.
# NEVER commit the real .env file to git.
# ============================================

# ─── Server ───────────────────────────────────
PORT=5000
SESSION_SECRET=replace-with-a-random-secret-string
CLIENT_URL=http://localhost:5173

# ─── AWS S3 ───────────────────────────────────
# Get these from: https://console.aws.amazon.com/iam/
# 1. Create an IAM user with S3 permissions
# 2. Create an S3 bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=your_aws_region_here
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
# Only this registered account can upload files.
UPLOAD_AUTHORIZED_EMAIL=authorized-user@gmail.com
