# ============================================
# CloudBox – Environment Variables
# ============================================
# Copy this file to backend/.env and fill in
# your real values.
# NEVER commit the real .env file to git.
# ============================================

# ─── Server ───────────────────────────────────
PORT=5000
SESSION_SECRET=replace-with-a-random-secret-string
CLIENT_URL=http://localhost:5173

# ─── Google OAuth 2.0 ─────────────────────────
# Get these from: https://console.cloud.google.com/
# 1. Create a project → APIs & Services → Credentials
# 2. Create an OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:5173/api/auth/google/callback
#    as an Authorized Redirect URI
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# ─── AWS S3 ───────────────────────────────────
# Get these from: https://console.aws.amazon.com/iam/
# 1. Create an IAM user with S3 permissions
# 2. Create an S3 bucket
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_REGION=your_aws_region_here
AWS_S3_BUCKET_NAME=your_s3_bucket_name_here
# Only this Google account can upload files.
UPLOAD_AUTHORIZED_EMAIL=authorized-user@gmail.com
